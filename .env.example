# ==========================================
# 1. CORE & RUNTIME
# ==========================================
NODE_ENV="development"
PORT=3005
HOST="0.0.0.0"
APP_ORIGIN="http://localhost:3005"

# ==========================================
# 2. STORAGE, CONFIG & DIRECTORIES
# ==========================================
# VPS Production Paths (/home/deploy/...):
CONFIG_DIR="/home/deploy/configs/starter-template"
DATA_DIR="/home/deploy/data/starter-template"
LOG_DIR="/home/deploy/logs/starter-template"
BACKUP_DIR="/home/deploy/backups/starter-template"
DATABASE_URL="file:/home/deploy/data/starter-template/starter-template.db"

# Local Development Fallbacks (uncomment for local dev):
# CONFIG_DIR="./configs"
# DATA_DIR="./data"
# LOG_DIR="./logs"
# BACKUP_DIR="./backups"
# DATABASE_URL="file:./data/starter-template.db"

# Docker Container Internal Paths (used inside container):
# CONFIG_DIR="/app/configs"
# DATA_DIR="/app/data"
# LOG_DIR="/app/logs"
# BACKUP_DIR="/app/backups"
# DATABASE_URL="file:/app/data/starter-template.db"

# ==========================================
# 3. LOGGING & MONITORING
# ==========================================
LOG_LEVEL="info"
GOOGLE_ANALYTICS_ID=""

# ==========================================
# 4. AUTHENTICATION & SECURITY
# ==========================================
AUTH_SECRET="change-this-to-a-super-secret-at-least-32-chars-long"

# ==========================================
# 5. AI INTEGRATION
# ==========================================
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.7-flash"
GEMINI_API_KEY=""

