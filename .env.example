# 1. Environment & Network
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# 2. Database & Storage Directories
DATABASE_URL="file:./prisma/dev.db"
DATA_DIR="./data"
LOG_DIR="./logs"
BACKUP_DIR="./backups"

# 3. Observability & Analytics
LOG_LEVEL="info"
GOOGLE_ANALYTICS_ID=""

# 4. Authentication & Security
AUTH_SECRET="change-this-to-a-super-secret-at-least-32-chars-long"

# 5. AI Integration (Optional)
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.0-flash"
GEMINI_API_KEY=""
