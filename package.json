{
	"name": "sveltekit-starter-template",
	"private": true,
	"version": "1.0.0",
	"description": "Standardized Canonical SvelteKit 2 + Tailwind 4 + Prisma Production Template",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"db:studio": "prisma studio",
		"seed:users": "tsx scripts/seed-users.ts",
		"backup": "tsx scripts/backup-db.ts",
		"deploy": "./scripts/deploy.sh",
		"deploy:docker": "./scripts/deploy-docker.sh",
		"update": "bash scripts/update.sh",
		"update:env": "bash scripts/update-env.sh"
	},
	"devDependencies": {
		"@eslint/js": "^9.20.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.2.11",
		"@sveltejs/kit": "^2.17.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.0.7",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^22.13.4",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.20.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.0.3",
		"globals": "^15.15.0",
		"prettier": "^3.5.1",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"prisma": "^6.4.0",
		"svelte": "^5.20.2",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^4.0.7",
		"tsx": "^4.19.3",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.24.1",
		"vite": "^6.1.0",
		"vitest": "^3.0.5"
	},
	"dependencies": {
		"@prisma/client": "^6.4.0",
		"bcryptjs": "^3.0.3",
		"clsx": "^2.1.1",
		"dotenv": "^16.4.7",
		"lucide-svelte": "^1.0.1",
		"tailwind-merge": "^3.0.1",
		"zod": "^3.24.2"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
